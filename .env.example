# Synapse address reachable by the bot
MATRIX_HOMESERVER=http://localhost:8008
# Bot account and its password (the bot gets a token itself on first login and stores it in data/session.json)
MATRIX_USER=@genabot:example.org
MATRIX_PASSWORD=

# Language of the bot's replies: en (default) or ru
BOT_LANG=en
# Command prefix: "!genabot keep 100", "!genabot help"
BOT_CMD=!genabot
# Who may invite the bot and give it commands (comma-separated). Empty: any user of the bot's own server
ALLOWED_INVITERS=@you:example.org
# Minimum power level in a room required to give commands
MIN_LEVEL=50

# Admin mode: the bot reads the whole history via the Synapse admin API and can erase history from the database
# (keep N without filters, purge older:...). Needs both ADMIN_MODE=1 and server-admin rights on the bot account. See README.
ADMIN_MODE=0

# Limits (optional)
# MAX_BULK=5000        max messages deleted per run
# CONFIRM_OVER=20      more than this needs confirmation (the word "yes")
# MAX_CMD_LEN=300      max command length
# MAX_CMD_AGE=120      commands older than this (seconds) are ignored
# RATE_MAX=8           commands per minute per user
